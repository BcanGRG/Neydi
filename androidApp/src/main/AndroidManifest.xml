<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        allowBackup="false" - VARSAYILAN "true" BIR GIZLILIK KACAGIYDI.
        API 26+ ile Android uygulamanin dosyalarini kullanicinin Google
        Drive'ina otomatik yedekliyor. Bu uygulamanin dosyalari: her alisverisi,
        fiyati ve hane uyesini tasiyan Room veritabani, ve `filesDir/receipts`
        altindaki fis JPEG'leri. F4.2 ham kamera dosyasini "fis kisisel veri;
        iki kopya hem yer hem gereksiz maruziyet" diye SILIYOR - manifest ise
        sessizce ucuncu bir kopyayi Drive'a gonderiyordu, yani belgelenmis
        karari dogrudan cürütüyordu.
    -->
    <!--
        KAMERA IZNI uygulama ici kamera icin (Ekran 4). Sistem kamerasi
        kullanilirken gerekmiyordu - o kendi izniyle calisiyor - ama cerceve
        rehberi, kare sayaci ve arka kamera secimi ancak onizlemeye BIZ
        sahipsek mumkun.

        `android.hardware.camera` OZELLIGI ZORUNLU DEGIL: kamerasiz bir cihazda
        uygulama yine calisir (liste, gecmis, ayarlar), yalnizca fis cekilemez.
        `required="false"` yazmazsak Play Store kamerasiz cihazlari tamamen
        eler.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".NeydiApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Neydi"
        android:supportsRtl="false"
        android:theme="@style/Theme.Neydi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Neydi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
